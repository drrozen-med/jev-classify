{
  "name": "@drrozen-med/jev-classify",
  "version": "0.3.0",
  "description": "Jev (TypeSafe System One) taxonomy classification machinery: typed-choice client, stepwise tree walk, and cost telemetry.",
  "license": "UNLICENSED",
  "type": "module",
  "engines": {
    "node": ">=22.6"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "node --test test/*.test.ts",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run typecheck && npm test && npm run build"
  },
  "keywords": [
    "jev",
    "typesafe",
    "taxonomy",
    "classification",
    "anesthesia",
    "cost-monitoring"
  ],
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/drrozen-med/jev-classify.git"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^5.9.3"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts"
}
